{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "rootDir": "resources/ts",
    "outDir": "public/assets/js",
    "strict": true,
    "noImplicitAny": true,
    "removeComments": false,
    "sourceMap": false,
    "skipLibCheck": true
  },
  "include": ["resources/ts/**/*.ts"]
}
